# Required
BOT_TOKEN=123456:your_bot_token
API_ID=123456
API_HASH=your_api_hash
DATABASE_URI=mongodb+srv://username:db-password@cluster.mongodb.net/
LOG_CHANNEL=-1001234567890
ADMINS=123456789

# Recommended
CHANNELS=-1001234567890
BIN_CHANNEL=-1001234567890
DATABASE_NAME=Cluster0
COLLECTION_NAME=dreamcinezone_files

# Web and streaming
PORT=8080
FQDN=your-app-name.onrender.com
HAS_SSL=True
NO_PORT=True
STREAM_MODE=True
PREMIUM_STREAM_MODE=False

# Force subscription
AUTH_CHANNELS=-1001234567890
AUTH_REQ_CHANNELS=-1001234567890
REQST_CHANNEL_ID=-1001234567890
SUPPORT_CHAT_ID=-1001234567890
SUPPORT_CHAT=https://t.me/your_support_group

# Optional features
IS_VERIFY=True
MAINTENANCE=False
TMDB_API_KEY=

# VPLink shortener / verification
# Add your real VPLink API key in your hosting environment; do not commit secrets.
IS_VERIFY=False
SHORTENER_WEBSITE=vplink.in
SHORTENER_API=your_vplink_api_key
SHORTENER_WEBSITE2=vplink.in
SHORTENER_API2=your_vplink_api_key
SHORTENER_WEBSITE3=vplink.in
SHORTENER_API3=your_vplink_api_key
GPLINKS_API_KEY=your_vplink_api_key
